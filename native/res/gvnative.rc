#include <winver.h>
#include "../src/version.hpp"
GLFW_ICON ICON "gvnative.ico"
1 VERSIONINFO
FILEVERSION GV_VERSION_RC
PRODUCTVERSION GV_VERSION_RC
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "GlassView"
      VALUE "FileDescription", "GlassView"
      VALUE "FileVersion", GV_VERSION
      VALUE "ProductName", "GlassView Native"
      VALUE "ProductVersion", GV_VERSION
      VALUE "OriginalFilename", "GlassViewNative.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
