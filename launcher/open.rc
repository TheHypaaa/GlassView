1 ICON "../app/icon.ico"
1 VERSIONINFO
FILEVERSION GV_V1,GV_V2,GV_V3,0
PRODUCTVERSION GV_V1,GV_V2,GV_V3,0
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "GlassView"
      VALUE "FileDescription", "GlassView"
      VALUE "FileVersion", GV_VSTR
      VALUE "InternalName", "GlassViewOpen"
      VALUE "OriginalFilename", "GlassViewOpen.exe"
      VALUE "ProductName", "GlassView"
      VALUE "ProductVersion", GV_VSTR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
